# =====================================================================
#  ENV LOKAL BACKEND (development tanpa Docker)
#  Hanya dibaca oleh `bun run dev` di folder backend.
#  TIDAK dipakai Docker Compose; untuk Docker pakai .env di folder utama.
# =====================================================================
# Salin menjadi backend/.env:
#   Command Prompt : copy .env.example .env

# Server Config
PORT=8000
JWT_SECRET="super-secret-key-ganti-di-produksi-minimal-32-karakter"
JWT_EXPIRE_MINUTES=480

# Database lokal dari perintah `docker run ... -p 5434:5432 postgres:15-alpine` di README.
# Tulis nilainya langsung: dotenv tidak mengganti ${VARIABEL} di dalam file .env.
DATABASE_URL="postgresql://fer:rahasia@localhost:5434/fer_db?schema=public"
