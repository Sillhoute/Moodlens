# Server Config
PORT=9000
JWT_SECRET="super-secret-key-ganti-di-produksi-minimal-32-karakter"
JWT_EXPIRE_MINUTES=480

# PostgreSQL Environment Variables
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_USER=fer
POSTGRES_PASSWORD=rahasia
POSTGRES_DB=fer_db

# Database URL untuk Backend Container (menggunakan nama service 'database' di Docker network)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"