{
  "name": "backend",
  "version": "1.0.0",
  "main": "src/server.ts",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "ts-node src/server.ts",
    "build": "tsc",
    "db:push": "node node_modules/prisma/build/index.js db push",
    "db:generate": "node node_modules/prisma/build/index.js generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Backend Express.js TypeScript untuk pengenalan ekspresi FER-2013 dengan ensemble TensorFlow.js & Prisma ORM",
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@tensorflow/tfjs": "^4.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "prisma": "5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2"
  }
}
