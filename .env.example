# Salin menjadi .env untuk menjalankan aplikasi secara lokal: cp .env.example .env
POSTGRES_USER=fer
# Gunakan huruf dan angka saja; karakter seperti @ atau : merusak alamat database.
POSTGRES_PASSWORD=ganti_dengan_password_anda
POSTGRES_DB=fer_db
# String acak minimal 32 karakter untuk menandatangani token login.
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
APP_PORT=8088
