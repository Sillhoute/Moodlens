# Salin menjadi .env di folder utama (sejajar docker-compose.yaml) sebelum `docker compose up`:
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
# File .env tidak ikut ter-commit. Ganti nilai di bawah ini dengan milik Anda sendiri.

POSTGRES_USER=fer
POSTGRES_PASSWORD=rahasia
POSTGRES_DB=fer_db

# String acak minimal 32 karakter
JWT_SECRET=super-secret-key-ganti-di-produksi-minimal-32-karakter
AUTH_SECRET=fer-ensemble-secret-key-super-aman-32-char-min!
