# =====================================================================
#  ENV DOCKER COMPOSE (deploy 3 container)
#  Hanya dibaca oleh `docker compose`. TIDAK dipakai `bun run dev`.
#  Untuk mode development tanpa Docker, pakai backend/.env dan frontend/.env.
# =====================================================================
# Salin menjadi .env di folder ini (sejajar docker-compose.yaml):
#   Command Prompt : copy .env.example .env
#   PowerShell     : Copy-Item .env.example .env
#   Git Bash       : cp .env.example .env
# File .env tidak ikut ter-commit. Saat deploy lewat CI/CD, nilai rahasia
# diambil dari GitHub Secrets, bukan dari file ini.

# --- Database (dipakai container database dan backend) ---
POSTGRES_USER=fer
POSTGRES_PASSWORD=rahasia
POSTGRES_DB=fer_db

# --- Backend ---
# String acak minimal 32 karakter
JWT_SECRET=super-secret-key-ganti-di-produksi-minimal-32-karakter
# Lama sesi login dalam menit (opsional, default 480)
JWT_EXPIRE_MINUTES=480

# --- Frontend (NextAuth) ---
AUTH_SECRET=moodlens-auth-secret-ganti-minimal-32-karakter

# --- Image dari Docker Hub (opsional) ---
# Kosongkan (beri # di depan) untuk build sendiri dari source code.
# Aktifkan untuk langsung memakai image hasil pipeline CI/CD:
# IMAGE_PREFIX=nicholaskosasih/moodlens
# IMAGE_TAG=latest
