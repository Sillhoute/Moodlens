# =====================================================================
#  ENV LOKAL FRONTEND (development tanpa Docker)
#  Hanya dibaca oleh `bun run dev` di folder frontend.
#  TIDAK dipakai Docker Compose; untuk Docker pakai .env di folder utama.
# =====================================================================
# Salin menjadi frontend/.env:
#   Command Prompt : copy .env.example .env

# Alamat backend yang berjalan dengan `bun run dev` (port 8000)
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
NEXTAUTH_URL="http://localhost:3000"

# Secret NextAuth (minimal 32 karakter bebas)
AUTH_SECRET="moodlens-auth-secret-ganti-minimal-32-karakter"
